# Public (safe for browser — baked into the build by Vite, so also set these as
# Cloudflare Pages/Workers *Build* variables, not only runtime vars)
PUBLIC_SUPABASE_URL=https://iktrzwenlqgfyjnlrczc.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Paddle (browser) ---
# Environment MUST be explicit. No default — the app fails loudly if unset so it
# can never run against the wrong Paddle account. Use "sandbox" or "production".
PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token (public). Sandbox tokens start with "test_", live with "live_".
# This is NOT the server API key — never put a server API key in a PUBLIC_* var.
PUBLIC_PADDLE_CLIENT_TOKEN=test_your-sandbox-client-token

# Server / CLI only — never expose to the browser
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.iktrzwenlqgfyjnlrczc.supabase.co:5432/postgres

# Edge Functions (set in Supabase secrets / local supabase):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Later: Flitt merchant id + payment secret (never PUBLIC_*)

# Paddle server API key — server→Paddle API calls. Used by the cancel-subscription
# Edge Function (user "unsubscribe"). NOT used by the pricing page / any client
# code, and NOT needed by the webhook (which authenticates via signature).
# Set it as a Supabase Edge Function secret, never in a PUBLIC_* var.
# PADDLE_API_KEY=your-server-api-key

# --- Paddle webhook (payment-webhook Edge Function) ---
# These are set as SUPABASE Edge Function secrets, NOT in this frontend .env:
#   supabase secrets set PADDLE_ENVIRONMENT=sandbox \
#     PADDLE_WEBHOOK_SECRET=pdl_ntfset_... \
#     PADDLE_PRICE_TIER_MAP='{"pri_...monthly":"maker","pri_...annual":"maker","pri_...lifetime":"lifetime"}' \
#     PADDLE_API_KEY=pdl_sdbx_apikey_...   # required by cancel-subscription
# See supabase/functions/README.md.
